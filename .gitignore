# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
!apps/web/.vscode/
!apps/web/.vscode/settings.json
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local environment files (commit only .env.example)
.env

# Files exported from the dev Docker container (the folder itself is kept, so Docker
# never creates it as root on Linux)
tk-app/exports/*
!tk-app/exports/.gitkeep

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Some global ignores drop .python-version; the API pins its Python version here
!apps/api/.python-version
