# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local environment files (commit only .env.example)
.env

# Files exported from the dev Docker container (the folder itself is kept, so Docker
# never creates it as root on Linux)
exports/*
!exports/.gitkeep
