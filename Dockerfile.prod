# Production image: source and runtime dependencies are baked in (no dev group, no bind
# mounts), VNC_PASSWORD is required, and the GUI restarts if it is closed or crashes.
# The official Python image ships Tkinter and the Tcl/Tk runtime the app needs.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    APP_MODE=prod

# A virtual display, a window manager, the VNC/noVNC stack, and fontconfig (fc-cache is
# used by font_loader.py to register the bundled Inter fonts).
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    xvfb x11vnc openbox novnc websockify \
    fonts-dejavu-core fontconfig \
    && rm -rf /var/lib/apt/lists/*

COPY --from=astral/uv:0.12.10 /uv /uvx /bin/

# Run as the host user's UID/GID so bind-mounted folders stay writable on Linux;
# scripts/docker.py passes them automatically there (Docker Desktop maps ownership itself).
ARG APP_UID=1000
ARG APP_GID=1000
RUN (getent group "$APP_GID" >/dev/null || groupadd --gid "$APP_GID" app) \
    && useradd --create-home --uid "$APP_UID" --gid "$APP_GID" app \
    && mkdir -p /app /opt/venv /workspace/exports /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix \
    && chown -R "$APP_UID:$APP_GID" /app /opt/venv /workspace

COPY docker/index.html /usr/share/novnc/index.html
COPY --chmod=755 docker/start.sh /usr/local/bin/policycoherencekit-start

USER app
WORKDIR /app

# Install dependencies first so source edits don't invalidate this layer.
COPY --chown=${APP_UID}:${APP_GID} pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-dev

COPY --chown=${APP_UID}:${APP_GID} . /app/

EXPOSE 6080

ENTRYPOINT ["tini", "--"]
CMD ["policycoherencekit-start"]
