# Copy to .env and adjust. Read by docker-compose-dev.yml (optional) and
# docker-compose-prod.yml (required). Both setups share this file, so a VNC_PASSWORD set
# for prod also password-protects the dev session.

# Password for the browser (noVNC) session. Required in production; leave empty in dev
# to connect without a password. VNC only checks the first 8 characters, and the session
# is not encrypted: expose it beyond localhost only behind a TLS reverse proxy.
VNC_PASSWORD=

# Virtual screen size and colour depth (WIDTHxHEIGHTxDEPTH). The app window is 1200x780.
SCREEN_GEOMETRY=1440x900x24

# Host port for the browser session (dev and prod). Defaults to 6090.
# NOVNC_PORT=6090

# Container user ID/group ID. On Linux, scripts/docker.py sets these to your user so the
# bind-mounted exports/ folder stays writable; override only if needed. Rebuild after changing.
# APP_UID=1000
# APP_GID=1000
